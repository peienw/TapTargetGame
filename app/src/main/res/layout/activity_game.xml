<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:background="#0B1024">

    <!-- Game label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦  NEON ARCADE  ✦"
        android:textColor="#A78BFA"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:layout_marginTop="14dp"/>

    <!-- Level indicator -->
    <TextView
        android:id="@+id/txtLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LEVEL 1 / 4"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:gravity="center"
        android:background="@drawable/bg_game_level"
        android:paddingHorizontal="28dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="18dp"/>

    <!-- Timer and Score HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="28dp">

        <!-- Timer -->
        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="TIME: 5s"
            android:textColor="#22D3EE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_game_hud"
            android:layout_marginEnd="7dp"/>

        <!-- Score -->
        <TextView
            android:id="@+id/txtScore"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SCORE: 0"
            android:textColor="#C084FC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_game_hud"
            android:layout_marginStart="7dp"/>
    </LinearLayout>

    <!-- Instruction heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FIND THE TARGET!"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginTop="42dp"/>

    <!-- Instruction subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap the glowing tile as quickly as possible"
        android:textColor="#9299C0"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="22dp"/>

    <!-- Game Grid: keep this directly inside the root layout -->
    <GridLayout
        android:id="@+id/gameGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"/>

    <!-- Bottom instruction panel -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡  REACT FAST  •  SCORE HIGH  ⚡"
        android:textColor="#A78BFA"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_game_instruction"
        android:padding="14dp"
        android:layout_marginTop="25dp"/>

</LinearLayout>
